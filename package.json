  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KabeerSingh28/campus-task-manager-demo.git"
  },
  "bugs": {
    "url": "https://github.com/KabeerSingh28/campus-task-manager-demo/issues"
  },
  "homepage": "https://github.com/KabeerSingh28/campus-task-manager-demo#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@kabeersingh/readme-buddy": "^0.1.0"
  }
}
