{
  "name": "campus-task-manager-demo",
  "version": "1.0.0",
  "description": "A simple command-line task management application for college students to manage their assignments, deadlines, and daily academic tasks.",
  "main": "src/index.js",
  "bin": {
    "campus-tasks": "./src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node test/taskManager.test.js",
    "generate-readme": "readme-buddy --force",
    "generate-readme:api": "node scripts/generate-readme.js",
    "preview-readme": "readme-buddy --dry-run"
  },
  "keywords": [
    "task-management",
    "college-assignments",
    "deadline-tracker",
    "student-productivity",
    "academic-planner",
    "cli-tool",
    "json-storage",
    "nodejs"
  ],
